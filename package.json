{
	"name": "windows-locale",
	"main": "index.json",
	"types": "index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./index.d.mts",
				"default": "./index.mjs"
			},
			"require": {
				"types": "./index.d.ts",
				"default": "./index.json"
			}
		},
		"./index.json": "./index.json",
		"./package.json": "./package.json"
	},
	"preferGlobal": false,
	"version": "1.2.0",
	"description": "Windows Language Code Identifier (LCID) for JavaScript",
	"author": {
		"name": "Tiago Danin",
		"email": "TiagoDanin@outlook.com",
		"url": "https://TiagoDanin.github.io"
	},
	"license": "MIT",
	"keywords": [
		"code",
		"i18n",
		"language",
		"languages",
		"lcid",
		"locale",
		"locales",
		"tag",
		"windows"
	],
	"scripts": {
		"build": "node build.js",
		"lint": "standard",
		"test": "standard && node test.js"
	},
	"standard": {
		"ignore": [
			"index.mjs"
		]
	},
	"engines": {
		"node": ">=v14.17.4"
	},
	"private": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/TiagoDanin/Windows-Locale.git"
	},
	"homepage": "https://TiagoDanin.github.io/Windows-Locale",
	"bugs": {
		"url": "https://github.com/TiagoDanin/Windows-Locale/issues"
	},
	"github": {
		"name": "Windows-Locale",
		"owner": "TiagoDanin"
	},
	"files": [
		"LICENSE",
		"README.md",
		"index.d.mts",
		"index.d.ts",
		"index.json",
		"index.mjs",
		"package.json"
	],
	"devDependencies": {
		"pdf2json": "^4.0.3",
		"standard": "^17.1.2"
	}
}
